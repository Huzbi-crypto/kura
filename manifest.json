{
  "manifest_version": 3,
  "name": "Kura — manga tracker",
  "version": "0.7.4",
  "description": "Manga-first reading tracker that keeps MyAnimeList, AniList and MangaBaka in step at once.",
  "permissions": ["storage", "alarms", "identity"],
  "host_permissions": [
    "https://graphql.anilist.co/*",
    "https://api.mangabaka.org/*",
    "https://api.myanimelist.net/*",
    "https://myanimelist.net/*",
    "https://atsu.moe/*",
    "https://stonescape.xyz/*",
    "https://weebcentral.com/*",
    "https://mangadot.net/*"
  ],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_popup": "popup/popup.html", "default_title": "Kura" },
  "content_scripts": [
    {
      "matches": [
        "https://atsu.moe/*",
        "https://stonescape.xyz/*",
        "https://weebcentral.com/*",
        "https://mangadot.net/*"
      ],
      "js": ["src/content/overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "128": "icons/icon128.png" }
}
